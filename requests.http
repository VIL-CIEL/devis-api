# Requêtes d'exemple pour tester l'API à la main.
#
# S'utilise avec l'extension REST Client de VS Code : un lien « Send Request »
# apparaît au-dessus de chaque requête, et la réponse s'affiche à droite.
# Le code attendu figure entre crochets dans le titre de chaque requête.
#
# Les requêtes se rejouent de haut en bas sur une base neuve : certaines
# dépendent des précédentes (identifiants créés, statuts changés). Avant de
# commencer, exécuter sql/schema.sql puis sql/donnees.sql, puis lancer le
# serveur avec npm run dev.

@base = http://localhost:3000


### ------------------------------------------------------------
# Santé et erreurs générales

### [200] Santé de l'API
GET {{base}}/health

### [404] Route inconnue
GET {{base}}/inconnue

### [400] Corps JSON mal formé
POST {{base}}/clients
Content-Type: application/json

{ "nom": }


### ------------------------------------------------------------
# Clients : lecture

### [200] Liste des clients
GET {{base}}/clients

### [200] Un client
GET {{base}}/clients/1

### [404] Client inexistant
GET {{base}}/clients/9999

### [400] Identifiant invalide
GET {{base}}/clients/abc


### ------------------------------------------------------------
# Clients : création (les deux créations réussies donnent les clients 7 et 8)

### [201] Créer un client complet (nom nettoyé, email en minuscules)
POST {{base}}/clients
Content-Type: application/json

{ "nom": "  Atelier Durand  ", "email": "Contact@Atelier-Durand.EXAMPLE.fr", "telephone": "0478000000" }

### [201] Créer un client avec seulement un nom (email et téléphone à null)
POST {{base}}/clients
Content-Type: application/json

{ "nom": "Garage Martin" }

### [400] Créer un client sans nom
POST {{base}}/clients
Content-Type: application/json

{ "email": "anonyme@example.fr" }

### [400] Nom fait d'espaces
POST {{base}}/clients
Content-Type: application/json

{ "nom": "   " }

### [400] Email du mauvais type
POST {{base}}/clients
Content-Type: application/json

{ "nom": "Test", "email": 42 }

### [400] Corps qui n'est pas un objet
POST {{base}}/clients
Content-Type: application/json

"juste une chaîne"


### ------------------------------------------------------------
# Clients : modification partielle (sur le client 7)

### [200] Modifier seulement le téléphone
PATCH {{base}}/clients/7
Content-Type: application/json

{ "telephone": "0478111111" }

### [200] Effacer l'email (email à null, le reste inchangé)
PATCH {{base}}/clients/7
Content-Type: application/json

{ "email": null }

### [200] Renommer (nom nettoyé)
PATCH {{base}}/clients/7
Content-Type: application/json

{ "nom": "  Atelier Durand et fils  " }

### [200] Vérifier que seuls les champs envoyés ont changé
GET {{base}}/clients/7

### [400] Corps vide
PATCH {{base}}/clients/7
Content-Type: application/json

{}

### [400] Nom à null
PATCH {{base}}/clients/7
Content-Type: application/json

{ "nom": null }

### [404] Client inexistant
PATCH {{base}}/clients/9999
Content-Type: application/json

{ "nom": "Personne" }

### [400] Identifiant invalide
PATCH {{base}}/clients/abc
Content-Type: application/json

{ "nom": "Test" }


### ------------------------------------------------------------
# Clients : suppression

### [409] Supprimer un client qui a des devis
DELETE {{base}}/clients/1

### [204] Supprimer un client sans devis (le client 8, créé plus haut)
DELETE {{base}}/clients/8

### [404] Supprimer le même client une seconde fois
DELETE {{base}}/clients/8

### [400] Identifiant invalide
DELETE {{base}}/clients/abc


### ------------------------------------------------------------
# Devis : lecture

### [200] Liste des devis
GET {{base}}/devis

### [200] Devis en brouillon
GET {{base}}/devis?statut=brouillon

### [200] Devis envoyés
GET {{base}}/devis?statut=envoye

### [400] Filtre sur un statut inconnu
GET {{base}}/devis?statut=valide

### [400] Filtre sur deux statuts à la fois
GET {{base}}/devis?statut=brouillon&statut=envoye

### [200] Devis avec lignes (total 289.86)
GET {{base}}/devis/1

### [200] Devis sans ligne (lignes vides, total 0.00)
GET {{base}}/devis/2

### [200] Devis envoyé (total 1015.00)
GET {{base}}/devis/3

### [404] Devis inexistant
GET {{base}}/devis/9999

### [400] Identifiant invalide
GET {{base}}/devis/abc


### ------------------------------------------------------------
# Devis : création

### [201] Créer un devis (statut brouillon)
POST {{base}}/devis
Content-Type: application/json

{ "client_id": 5 }

### [404] Créer un devis pour un client inexistant
POST {{base}}/devis
Content-Type: application/json

{ "client_id": 9999 }

### [400] client_id en chaîne
POST {{base}}/devis
Content-Type: application/json

{ "client_id": "5" }

### [400] client_id décimal
POST {{base}}/devis
Content-Type: application/json

{ "client_id": 1.5 }

### [400] Corps sans client_id
POST {{base}}/devis
Content-Type: application/json

{}


### ------------------------------------------------------------
# Lignes de devis

### [201] Ajouter une ligne au devis 1 (brouillon)
POST {{base}}/devis/1/lignes
Content-Type: application/json

{ "designation": "Routeur 4G de secours", "quantite": 1, "prix_unitaire_ht": 129.00 }

### [409] Ajouter une ligne au devis 3 (envoyé)
POST {{base}}/devis/3/lignes
Content-Type: application/json

{ "designation": "Ligne en trop", "quantite": 1, "prix_unitaire_ht": 10 }

### [400] Quantité nulle
POST {{base}}/devis/1/lignes
Content-Type: application/json

{ "designation": "Test", "quantite": 0, "prix_unitaire_ht": 10 }

### [400] Prix négatif
POST {{base}}/devis/1/lignes
Content-Type: application/json

{ "designation": "Test", "quantite": 1, "prix_unitaire_ht": -5 }

### [400] Prix au-delà de la borne de la colonne
POST {{base}}/devis/1/lignes
Content-Type: application/json

{ "designation": "Test", "quantite": 1, "prix_unitaire_ht": 1000000000 }

### [400] Désignation vide
POST {{base}}/devis/1/lignes
Content-Type: application/json

{ "designation": "   ", "quantite": 1, "prix_unitaire_ht": 10 }

### [404] Ajouter une ligne à un devis inexistant
POST {{base}}/devis/9999/lignes
Content-Type: application/json

{ "designation": "Test", "quantite": 1, "prix_unitaire_ht": 10 }

### [204] Retirer la ligne 1 du devis 1
DELETE {{base}}/devis/1/lignes/1

### [404] Retirer la même ligne une seconde fois
DELETE {{base}}/devis/1/lignes/1

### [404] Retirer, via le devis 1, une ligne qui appartient au devis 3
DELETE {{base}}/devis/1/lignes/4

### [409] Retirer une ligne du devis 3 (envoyé)
DELETE {{base}}/devis/3/lignes/4

### [200] Devis 1 après ces changements (total 358.96)
GET {{base}}/devis/1


### ------------------------------------------------------------
# Statuts

### [409] Envoyer le devis 2, qui n'a aucune ligne
POST {{base}}/devis/2/statut
Content-Type: application/json

{ "statut": "envoye" }

### [409] Passer le devis 1 de brouillon à signé
POST {{base}}/devis/1/statut
Content-Type: application/json

{ "statut": "signe" }

### [200] Envoyer le devis 1 (updated_at change)
POST {{base}}/devis/1/statut
Content-Type: application/json

{ "statut": "envoye" }

### [409] Envoyer le devis 1 une seconde fois
POST {{base}}/devis/1/statut
Content-Type: application/json

{ "statut": "envoye" }

### [409] Ajouter une ligne au devis 1, désormais figé
POST {{base}}/devis/1/lignes
Content-Type: application/json

{ "designation": "Trop tard", "quantite": 1, "prix_unitaire_ht": 10 }

### [200] Signer le devis 1
POST {{base}}/devis/1/statut
Content-Type: application/json

{ "statut": "signe" }

### [409] Changer le statut du devis 4 (refusé, statut final)
POST {{base}}/devis/4/statut
Content-Type: application/json

{ "statut": "envoye" }

### [400] Statut inconnu
POST {{base}}/devis/3/statut
Content-Type: application/json

{ "statut": "valide" }

### [400] Corps sans statut
POST {{base}}/devis/3/statut
Content-Type: application/json

{}

### [404] Changer le statut d'un devis inexistant
POST {{base}}/devis/9999/statut
Content-Type: application/json

{ "statut": "envoye" }
