# Requêtes d'exemple pour tester l'API à la main.
#
# S'utilise avec l'extension REST Client de VS Code : un lien « Send Request »
# apparaît au-dessus de chaque requête, et la réponse s'affiche à droite.
# Les requêtes sont séparées par ###. Chaque route y figure avec son cas
# réussi et ses cas d'erreur (400, 404, 409), pour qu'on puisse vérifier les
# codes de réponse sans écrire de client.
#
# Prérequis : la base créée avec sql/schema.sql et le serveur lancé avec
# npm run dev. Les requêtes passent par index.ts, puis par
# routes/clients.ts ou routes/devis.ts selon le préfixe.

@base = http://localhost:3000

### Santé de l'API
GET {{base}}/health

### Route inconnue (doit répondre 404)
GET {{base}}/inconnue

### JSON mal formé (doit répondre 400)
POST {{base}}/health
Content-Type: application/json

{ "nom":}

### Liste des clients (200)
GET {{base}}/clients

### Un client (200)
GET {{base}}/clients/1

### Client inexistant (404)
GET {{base}}/clients/9999

### Identifiant invalide (400)
GET {{base}}/clients/abc

### Créer un client complet (201)
POST {{base}}/clients
Content-Type: application/json

{ "nom": "  Atelier Durand  ", "email": "Contact@Atelier-Durand.EXAMPLE.fr", "telephone": "0478000000" }

### Créer un client avec seulement un nom (201)
POST {{base}}/clients
Content-Type: application/json

{ "nom": "Garage Martin" }

### Créer un client sans nom (400)
POST {{base}}/clients
Content-Type: application/json

{ "email": "anonyme@example.fr" }

### Nom fait d'espaces (400)
POST {{base}}/clients
Content-Type: application/json

{ "nom": "   " }

### Email du mauvais type (400)
POST {{base}}/clients
Content-Type: application/json

{ "nom": "Test", "email": 42 }

### Corps qui n'est pas un objet (400)
POST {{base}}/clients
Content-Type: application/json

"juste une chaîne"

### Supprimer un client (204) : remplace 7 par l'id renvoyé par une création
DELETE {{base}}/clients/7

### Supprimer le même client une seconde fois (404)
DELETE {{base}}/clients/7

### Supprimer avec un identifiant invalide (400)
DELETE {{base}}/clients/abc

### Modifier seulement le téléphone (200)
PATCH {{base}}/clients/1
Content-Type: application/json

{ "telephone": "0478111111" }

### Effacer l'email (200, email à null, le reste inchangé)
PATCH {{base}}/clients/1
Content-Type: application/json

{ "email": null }

### Renommer avec des espaces autour (200, nom nettoyé)
PATCH {{base}}/clients/1
Content-Type: application/json

{ "nom": "  Boulangerie Martin  " }

### Corps vide (400)
PATCH {{base}}/clients/1
Content-Type: application/json

{}

### Nom à null (400)
PATCH {{base}}/clients/1
Content-Type: application/json

{ "nom": null }

### Client inexistant (404)
PATCH {{base}}/clients/9999
Content-Type: application/json

{ "nom": "Personne" }

### Identifiant invalide (400)
PATCH {{base}}/clients/abc
Content-Type: application/json

{ "nom": "Test" }

### Supprimer un client qui a des devis (409)
DELETE {{base}}/clients/1

### Lister les devis (200)
GET {{base}}/devis

### Créer un devis (201, statut brouillon)
POST {{base}}/devis
Content-Type: application/json

{ "client_id": 2 }

### Créer un devis pour un client inexistant (404)
POST {{base}}/devis
Content-Type: application/json

{ "client_id": 9999 }

### client_id en chaîne (400)
POST {{base}}/devis
Content-Type: application/json

{ "client_id": "2" }

### client_id décimal (400)
POST {{base}}/devis
Content-Type: application/json

{ "client_id": 1.5 }

### Corps sans client_id (400)
POST {{base}}/devis
Content-Type: application/json

{}

### Devis avec lignes (200, total 289.86)
GET {{base}}/devis/1

### Devis sans ligne (200, lignes vides, total 0.00)
GET {{base}}/devis/2

### Devis envoyé (200, total 1015.00)
GET {{base}}/devis/3

### Devis inexistant (404)
GET {{base}}/devis/9999

### Identifiant invalide (400)
GET {{base}}/devis/abc

### Ajouter une ligne à un brouillon (201)
POST {{base}}/devis/1/lignes
Content-Type: application/json

{ "designation": "Routeur 4G de secours", "quantite": 1, "prix_unitaire_ht": 129.00 }

### Ajouter une ligne à un devis envoyé (409)
POST {{base}}/devis/3/lignes
Content-Type: application/json

{ "designation": "Ligne en trop", "quantite": 1, "prix_unitaire_ht": 10 }

### Quantité nulle (400)
POST {{base}}/devis/1/lignes
Content-Type: application/json

{ "designation": "Test", "quantite": 0, "prix_unitaire_ht": 10 }

### Prix négatif (400)
POST {{base}}/devis/1/lignes
Content-Type: application/json

{ "designation": "Test", "quantite": 1, "prix_unitaire_ht": -5 }

### Prix trop grand (400, pas 500)
POST {{base}}/devis/1/lignes
Content-Type: application/json

{ "designation": "Test", "quantite": 1, "prix_unitaire_ht": 1000000000 }

### Désignation vide (400)
POST {{base}}/devis/1/lignes
Content-Type: application/json

{ "designation": "   ", "quantite": 1, "prix_unitaire_ht": 10 }

### Devis inexistant (404)
POST {{base}}/devis/9999/lignes
Content-Type: application/json

{ "designation": "Test", "quantite": 1, "prix_unitaire_ht": 10 }

### Retirer une ligne d'un brouillon (204)
DELETE {{base}}/devis/1/lignes/1

### Retirer la même ligne une seconde fois (404)
DELETE {{base}}/devis/1/lignes/1

### Retirer une ligne qui appartient à un autre devis (404)
DELETE {{base}}/devis/1/lignes/4

### Retirer une ligne d'un devis envoyé (409)
DELETE {{base}}/devis/3/lignes/4

### Envoyer un devis sans ligne (409)
POST {{base}}/devis/2/statut
Content-Type: application/json

{ "statut": "envoye" }

### Sauter de brouillon à signé (409)
POST {{base}}/devis/1/statut
Content-Type: application/json

{ "statut": "signe" }

### Envoyer le devis 1 (200, updated_at change)
POST {{base}}/devis/1/statut
Content-Type: application/json

{ "statut": "envoye" }

### L'envoyer une seconde fois (409)
POST {{base}}/devis/1/statut
Content-Type: application/json

{ "statut": "envoye" }

### Ajouter une ligne au devis 1, désormais figé (409)
POST {{base}}/devis/1/lignes
Content-Type: application/json

{ "designation": "Trop tard", "quantite": 1, "prix_unitaire_ht": 10 }

### Signer le devis 1 (200)
POST {{base}}/devis/1/statut
Content-Type: application/json

{ "statut": "signe" }

### Changer le statut d'un devis refusé (409)
POST {{base}}/devis/4/statut
Content-Type: application/json

{ "statut": "envoye" }

### Statut inconnu (400)
POST {{base}}/devis/3/statut
Content-Type: application/json

{ "statut": "valide" }

### Corps sans statut (400)
POST {{base}}/devis/3/statut
Content-Type: application/json

{}

### Devis inexistant (404)
POST {{base}}/devis/9999/statut
Content-Type: application/json

{ "statut": "envoye" }